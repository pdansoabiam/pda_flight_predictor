      "  Temporal: ['Year', 'Quarter', 'Month', 'DayofMonth', 'DayOfWeek']\n",
      "  Schedule: ['CRSDepTime', 'CRSArrTime', 'DepTimeBlk']\n",
      "  Route: ['Origin', 'Dest', 'Distance', 'DistanceGroup']\n",
