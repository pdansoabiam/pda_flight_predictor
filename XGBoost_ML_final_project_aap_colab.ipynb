   "source": [
    "# Remove duplicates and missing values\n",
    "\n",
    "df = df.drop_duplicates().dropna().reset_index(drop=True)\n",
    "\n",
    "# Strip whitespace\n",
    "for col in df.select_dtypes(include=['object']).columns:\n",
