   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PREDICTION RESULT: This flight is expected to be ON TIME ✈️✅\n",
      "Delay probability: 22.3%\n",
      " \n",
      "=======END OF PREDICTION=====\n"
     ]
